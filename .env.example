# Copy to .env and adjust if needed. Every value below is a LOCAL-ONLY default
# matching compose.yml — nothing here is a real credential.

# Warehouse (Postgres 16 standing in for Redshift; host port 5433 to avoid
# colliding with any local Postgres on 5432)
FANUNI_DATABASE_URL=postgresql://fanuni:fanuni_local@localhost:5433/fanuni

# Lake (MinIO exposes a real S3 API; the same boto3 code targets AWS S3 by
# dropping the endpoint override)
FANUNI_S3_ENDPOINT_URL=http://localhost:9000
FANUNI_S3_ACCESS_KEY=minioadmin
FANUNI_S3_SECRET_KEY=minioadmin
FANUNI_LAKE_BUCKET=fanuni-lake

# Mock Salesforce API
FANUNI_SF_BASE_URL=http://localhost:8001
FANUNI_SF_TOKEN=dev-local-token

# Prefect (optional: point flows at the compose server's UI; flows also run
# without it via Prefect's ephemeral mode)
# PREFECT_API_URL=http://localhost:4200/api
